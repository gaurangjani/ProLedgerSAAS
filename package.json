{
  "name": "ledgerpro-saas",
  "version": "1.0.0",
  "description": "LedgerPro SaaS — multi-tenant accounting software",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "vite --config client-src/vite.config.js",
    "build:client": "vite build --config client-src/vite.config.js",
    "preview:client": "vite preview --config client-src/vite.config.js",
    "install:all": "npm install && cd server && npm install",
    "start": "cd server && npm start"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0"
  }
}
